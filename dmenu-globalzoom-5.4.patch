+/* The X root owns a signed integer zoom offset; no daemon is involved. */
+static int
+globalzoomread(void)
+{
+    Atom type;
+    int fmt, value = 0;
+    unsigned long count, after;
+    unsigned char *data = NULL;
+    if (XGetWindowProperty(dpy, root, globalzoomatom, 0, 1, False,
+        XA_INTEGER, &type, &fmt, &count, &after, &data) == Success) {
+        if (type == XA_INTEGER && fmt == 32 && count == 1)
+            value = (int)(int32_t)((long *)data)[0];
+        if (data) XFree(data);
+    }
+    return MAX(-4, MIN(12, value));
+}
+
+static void
+menuchange(int delta)
+{
+    FcPattern *pattern;
+    FcChar8 *name;
+    char *scaled[LENGTH(fonts)] = {0};
+    Fnt *old, *new;
+    double pts, px, initial, change;
+    int i, n, pixelmode, y;
+
+    n = menusize + delta;
+    if (n < 6 || n > 36 || !delta)
+        return;
+    change = n - menudefault;
+    for (i = 0; i < (int)LENGTH(fonts); i++) {
+        if (!(pattern = FcNameParse((FcChar8 *)fonts[i])))
+            goto out;
+        pixelmode = FcPatternGetDouble(pattern, FC_PIXEL_SIZE, 0, &px)
+            == FcResultMatch;
+        if (pixelmode)
+            initial = px;
+        else if (FcPatternGetDouble(pattern, FC_SIZE, 0, &pts)
+                 == FcResultMatch)
+            initial = pts;
+        else
+            initial = menudefault;
+        if (initial + change < 6) {
+            FcPatternDestroy(pattern);
+            goto out;
+        }
+        FcPatternDel(pattern, FC_SIZE);
+        FcPatternDel(pattern, FC_PIXEL_SIZE);
+        if (!FcPatternAddDouble(pattern, pixelmode ? FC_PIXEL_SIZE : FC_SIZE,
+                                initial + change)) {
+            FcPatternDestroy(pattern);
+            goto out;
+        }
+        name = FcNameUnparse(pattern);
+        FcPatternDestroy(pattern);
+        if (!name)
+            goto out;
+        scaled[i] = (char *)name;
+    }
+    old = drw->fonts;
+    if (!(new = drw_fontset_create(drw, scaled, LENGTH(scaled)))) {
+        drw->fonts = old;
+        goto out;
+    }
+    drw_fontset_free(old);
+    menusize = n;
+    lrpad = drw->fonts->h;
+    bh = drw->fonts->h + 2;
+    lines = MIN(menulines, MAX(0, menumaxheight / bh - 1));
+    mh = (lines + 1) * bh;
+    promptw = (prompt && *prompt) ? TEXTW(prompt) - lrpad / 4 : 0;
+    y = topbar ? menutop : menubottom - mh;
+    XMoveResizeWindow(dpy, win, menux, y, mw, mh);
+    drw_resize(drw, mw, mh);
+    calcoffsets();
+    drawmenu();
+out:
+    for (i = 0; i < (int)LENGTH(fonts); i++)
+        if (scaled[i]) FcStrFree((FcChar8 *)scaled[i]);
+}
+
+static void
+globalzoomwrite(int delta, int reset)
+{
+    long n = reset ? 0 : globalzoomread() + delta;
+    n = MAX(-4, MIN(12, n));
+    XChangeProperty(dpy, root, globalzoomatom, XA_INTEGER, 32,
+                    PropModeReplace, (unsigned char *)&n, 1);
+    XFlush(dpy);
+}
+
+static void
+globalzoomupdate(void)
+{
+    int n = globalzoomread(), delta = n - globalzoomsteps;
+    menuchange(delta);
+    globalzoomsteps = n;
+}
